#!/bin/bash
# Align VK Music WebApp window to scratchpad
# Laptop: left half of focused monitor, full height
# Desktop: top-right half of focused monitor, 50% height

music_addr=$(hyprctl clients -j | jq -r '.[] | select(.class | test("^chrome-(vk\\.com__audio|music\\.vk\\.com)"; "i")) | .address' | head -n1)
if [[ -z "$music_addr" ]]; then
  exit 0
fi

mon_info=$(hyprctl monitors -j | jq '.[] | select(.focused)')
mon_x=$(echo "$mon_info" | jq '.x // 0')
mon_w=$(echo "$mon_info" | jq '((.width // 1920) / (.scale // 1)) | floor')
mon_h=$(echo "$mon_info" | jq '((.height // 1080) / (.scale // 1)) | floor')
mon_name=$(echo "$mon_info" | jq -r '.name // ""')

bar_h=28
gap=10

PROFILE="desktop"
if [ -f "$HOME/.config/omarchy/profile" ]; then
  PROFILE="$(cat "$HOME/.config/omarchy/profile" 2>/dev/null)"
elif [[ "$mon_name" =~ ^eDP ]]; then
  PROFILE="laptop"
fi

if [[ "$PROFILE" == "laptop" ]]; then
  # Ноутбук: 50% ширины экрана, полная высота, СЛЕВА
  avail_w=$(( mon_w - (gap * 3) ))
  win_w=$(( avail_w / 2 ))
  win_h=$(( mon_h - bar_h - (gap * 2) ))
  target_x=$(( mon_x + gap ))
  target_y=$gap
else
  # Десктоп: 50% ширины экрана, 50% высоты, СПРАВА СВЕРХУ
  win_w=$(( (mon_w / 2) - 20 ))
  avail_h=$(( mon_h - bar_h - (gap * 3) ))
  win_h=$(( avail_h / 2 ))
  target_x=$(( mon_x + mon_w - win_w - 20 ))
  target_y=$gap
fi

hyprctl eval "
  hl.dispatch(hl.dsp.window.resize({ x = $win_w, y = $win_h, relative = false, window = 'address:$music_addr' }));
  hl.dispatch(hl.dsp.window.move({ x = $target_x, y = $target_y, relative = false, window = 'address:$music_addr' }))
" >/dev/null 2>&1
