#!/bin/bash
# Align Telegram popup window to bottom-right corner above status bar of focused monitor

tg_addr=$(hyprctl clients -j | jq -r '.[] | select((.class | test("telegram"; "i")) or (.initialClass | test("telegram"; "i"))) | .address' | head -n1)
if [[ -z "$tg_addr" ]]; then
  exit 0
fi

mon_info=$(hyprctl monitors -j | jq '.[] | select(.focused)')
mon_x=$(echo "$mon_info" | jq '.x // 0')
mon_w=$(echo "$mon_info" | jq '((.width // 1920) / (.scale // 1)) | floor')
mon_h=$(echo "$mon_info" | jq '((.height // 1080) / (.scale // 1)) | floor')
bar_h=26
gap=12

# Width: 1/4 of the monitor width with 20px right margin
win_w=$(( (mon_w / 4) - 20 ))
win_h=550
target_x=$(( mon_x + mon_w - win_w - 20 ))
target_y=$(( mon_h - win_h - bar_h - gap ))

hyprctl eval "
  hl.dispatch(hl.dsp.window.resize({ x = $win_w, y = $win_h, relative = false, window = 'address:$tg_addr' }));
  hl.dispatch(hl.dsp.window.move({ x = $target_x, y = $target_y, relative = false, window = 'address:$tg_addr' }))
" >/dev/null 2>&1
