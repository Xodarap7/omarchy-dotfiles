#!/bin/bash
# Align Telegram popup window to scratchpad
# Laptop: right half of focused monitor, full height
# Desktop: bottom-right of focused monitor, 50% height

tg_addr=$(hyprctl clients -j | jq -r '.[] | select((.class | test("telegram"; "i")) or (.initialClass | test("telegram"; "i"))) | .address' | head -n1)
if [[ -z "$tg_addr" ]]; then
  exit 0
fi

mon_info=$(hyprctl monitors -j | jq '.[] | select(.focused)')
mon_x=$(echo "$mon_info" | jq '.x // 0')
mon_w=$(echo "$mon_info" | jq '((.width // 1920) / (.scale // 1)) | floor')
mon_h=$(echo "$mon_info" | jq '((.height // 1080) / (.scale // 1)) | floor')
mon_name=$(echo "$mon_info" | jq -r '.name // ""')

bar_h=28
gap=10

PROFILE="desktop"
if [ -f "$HOME/.config/omarchy/profile" ]; then
  PROFILE="$(cat "$HOME/.config/omarchy/profile" 2>/dev/null)"
elif [[ "$mon_name" =~ ^eDP ]]; then
  PROFILE="laptop"
fi

if [[ "$PROFILE" == "laptop" ]]; then
  # Ноутбук: 50% ширины экрана, полная высота, СПРАВА
  avail_w=$(( mon_w - (gap * 3) ))
  win_w=$(( avail_w / 2 ))
  win_h=$(( mon_h - bar_h - (gap * 2) ))
  target_x=$(( mon_x + gap + win_w + gap ))
  target_y=$gap
else
  # Десктоп: 1/4 ширины (мин 420px), 50% высоты, СПРАВА СНИЗУ
  calc_w=$(( (mon_w / 4) - 20 ))
  if (( calc_w < 420 )); then
    win_w=420
  else
    win_w=$calc_w
  fi
  avail_h=$(( mon_h - bar_h - (gap * 3) ))
  win_h=$(( avail_h / 2 ))
  target_x=$(( mon_x + mon_w - win_w - 20 ))
  target_y=$(( gap + win_h + gap ))
fi

hyprctl eval "
  hl.dispatch(hl.dsp.window.resize({ x = $win_w, y = $win_h, relative = false, window = 'address:$tg_addr' }));
  hl.dispatch(hl.dsp.window.move({ x = $target_x, y = $target_y, relative = false, window = 'address:$tg_addr' }))
" >/dev/null 2>&1
